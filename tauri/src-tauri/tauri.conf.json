{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stopwatch",
  "mainBinaryName": "stopwatch",
  "version": "../../package.json",
  "identifier": "dev.local.stopwatch",
  "build": {
    "frontendDist": "./placeholder"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../webroot": "webroot"
    },
    "category": "Productivity",
    "shortDescription": "local-first stopwatches and timers",
    "longDescription": "Local-first stopwatches and timers on a watch face: run several at once, name them, and count down from hours and minutes. Nothing leaves your machine.",
    "copyright": "Copyright © Niclas Lindstedt",
    "macOS": {
      "entitlements": "entitlements.mac.plist",
      "minimumSystemVersion": "10.15"
    }
  }
}
